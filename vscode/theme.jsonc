// Cynosure — VS Code colour theme template.
// build.py renders this once per entry in vscode/variants.json; every
// placeholder (double braces) is a *role* defined there, optionally with an
// alpha suffix.
//
// Layout of the look (both variants):
//   title bar      = the "CONTROL PANEL" header strip (strip-bg / strip-fg)
//   activity +
//   status bar     = the terminal frame (frame-bg / frame-fg)
//   editor         = the panel body; sidebars and panels one step darker/lighter
//   rules          = hard 1px lines in the text colour at low alpha
{
  "name": "{{name}}",
  "type": "{{type}}",
  "semanticHighlighting": true,
  "colors": {
    // --- Base ----------------------------------------------------------------
    "focusBorder": "{{accent|b3}}",
    "foreground": "{{fg}}",
    "descriptionForeground": "{{fg|99}}",
    "disabledForeground": "{{fg|66}}",
    "errorForeground": "{{error}}",
    "icon.foreground": "{{fg|cc}}",
    "widget.border": "{{rule|4d}}",
    "widget.shadow": "#00000066",
    "selection.background": "{{editor-select}}",
    "sash.hoverBorder": "{{accent|80}}",
    "textLink.foreground": "{{syn-function}}",
    "textLink.activeForeground": "{{accent}}",
    "textPreformat.foreground": "{{syn-string}}",
    "textBlockQuote.background": "{{bg-alt}}",
    "textBlockQuote.border": "{{rule|66}}",

    // --- Title bar: the header strip -----------------------------------------
    "titleBar.activeBackground": "{{strip-bg}}",
    "titleBar.activeForeground": "{{strip-fg}}",
    "titleBar.inactiveBackground": "{{bg-raised}}",
    "titleBar.inactiveForeground": "{{fg|99}}",
    "titleBar.border": "{{rule|4d}}",
    "menubar.selectionBackground": "{{strip-fg|26}}",
    "menubar.selectionForeground": "{{strip-fg}}",
    "commandCenter.background": "{{strip-fg|14}}",
    "commandCenter.foreground": "{{strip-fg}}",
    "commandCenter.activeBackground": "{{strip-fg|26}}",
    "commandCenter.border": "{{strip-fg|4d}}",
    "commandCenter.activeBorder": "{{strip-fg|80}}",
    "commandCenter.inactiveForeground": "{{fg|99}}",

    // --- Menus -----------------------------------------------------------------
    "menu.background": "{{bg-raised}}",
    "menu.foreground": "{{fg}}",
    "menu.selectionBackground": "{{select-bg}}",
    "menu.selectionForeground": "{{select-fg}}",
    "menu.separatorBackground": "{{rule|4d}}",
    "menu.border": "{{rule|99}}",

    // --- Activity bar + status bar: the terminal frame ----------------------
    "activityBar.background": "{{frame-bg}}",
    "activityBar.foreground": "{{frame-fg}}",
    "activityBar.inactiveForeground": "{{frame-fg|80}}",
    "activityBar.border": "{{rule|33}}",
    "activityBar.activeBorder": "{{frame-fg}}",
    "activityBar.activeBackground": "{{frame-fg|1a}}",
    "activityBarBadge.background": "{{warn}}",
    "activityBarBadge.foreground": "{{bg}}",

    "statusBar.background": "{{frame-bg}}",
    "statusBar.foreground": "{{frame-fg}}",
    "statusBar.border": "{{rule|4d}}",
    "statusBar.noFolderBackground": "{{frame-bg}}",
    "statusBar.debuggingBackground": "{{warn}}",
    "statusBar.debuggingForeground": "{{bg}}",
    "statusBarItem.hoverBackground": "{{frame-fg|26}}",
    "statusBarItem.activeBackground": "{{frame-fg|40}}",
    "statusBarItem.remoteBackground": "{{strip-bg}}",
    "statusBarItem.remoteForeground": "{{strip-fg}}",
    "statusBarItem.errorBackground": "{{error}}",
    "statusBarItem.errorForeground": "{{bg}}",
    "statusBarItem.warningBackground": "{{warn}}",
    "statusBarItem.warningForeground": "{{bg}}",
    "statusBarItem.prominentBackground": "{{frame-fg|26}}",

    // --- Side bar -------------------------------------------------------------
    "sideBar.background": "{{bg-alt}}",
    "sideBar.foreground": "{{fg}}",
    "sideBar.border": "{{rule|4d}}",
    "sideBarTitle.foreground": "{{fg}}",
    "sideBarSectionHeader.background": "{{bg-raised}}",
    "sideBarSectionHeader.foreground": "{{fg}}",
    "sideBarSectionHeader.border": "{{rule|4d}}",

    // --- Lists & trees: selected rows like the "Messages" list ---------------
    "list.activeSelectionBackground": "{{select-bg}}",
    "list.activeSelectionForeground": "{{select-fg}}",
    "list.activeSelectionIconForeground": "{{select-fg}}",
    "list.inactiveSelectionBackground": "{{select-bg|66}}",
    "list.inactiveSelectionForeground": "{{fg}}",
    "list.hoverBackground": "{{fg|14}}",
    "list.focusOutline": "{{accent|b3}}",
    "list.highlightForeground": "{{find}}",
    "list.errorForeground": "{{error}}",
    "list.warningForeground": "{{warn}}",
    "tree.indentGuidesStroke": "{{rule|40}}",

    // --- Editor ---------------------------------------------------------------
    "editor.background": "{{bg}}",
    "editor.foreground": "{{fg}}",
    "editorLineNumber.foreground": "{{fg|4d}}",
    "editorLineNumber.activeForeground": "{{fg}}",
    "editorCursor.foreground": "{{cursor}}",
    "editor.selectionBackground": "{{editor-select}}",
    "editor.inactiveSelectionBackground": "{{select-bg|33}}",
    "editor.selectionHighlightBackground": "{{fg|1f}}",
    "editor.wordHighlightBackground": "{{fg|1f}}",
    "editor.wordHighlightStrongBackground": "{{fg|33}}",
    "editor.findMatchBackground": "{{find|80}}",
    "editor.findMatchHighlightBackground": "{{find|40}}",
    "editor.findMatchBorder": "{{find}}",
    "editor.lineHighlightBackground": "{{fg|0d}}",
    "editor.lineHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "{{fg|0d}}",
    "editorIndentGuide.background1": "{{rule|1a}}",
    "editorIndentGuide.activeBackground1": "{{rule|4d}}",
    "editorWhitespace.foreground": "{{fg|26}}",
    "editorRuler.foreground": "{{rule|1a}}",
    "editorBracketMatch.background": "{{select-bg|4d}}",
    "editorBracketMatch.border": "{{accent|99}}",
    "editorLink.activeForeground": "{{syn-function}}",
    "editorError.foreground": "{{error}}",
    "editorWarning.foreground": "{{warn}}",
    "editorInfo.foreground": "{{info}}",
    "editorHint.foreground": "{{fg|99}}",
    "editorGutter.background": "{{bg}}",
    "editorGutter.addedBackground": "{{success}}",
    "editorGutter.modifiedBackground": "{{warn}}",
    "editorGutter.deletedBackground": "{{error}}",
    "editorOverviewRuler.border": "{{rule|1a}}",
    "editorCodeLens.foreground": "{{fg|80}}",
    "editorInlayHint.background": "{{fg|14}}",
    "editorInlayHint.foreground": "{{fg|99}}",

    // Widgets: find box, hover, suggest — boxes with a hard rule
    "editorWidget.background": "{{bg-raised}}",
    "editorWidget.foreground": "{{fg}}",
    "editorWidget.border": "{{rule|99}}",
    "editorHoverWidget.background": "{{bg-raised}}",
    "editorHoverWidget.border": "{{rule|99}}",
    "editorSuggestWidget.background": "{{bg-raised}}",
    "editorSuggestWidget.border": "{{rule|99}}",
    "editorSuggestWidget.selectedBackground": "{{select-bg}}",
    "editorSuggestWidget.selectedForeground": "{{select-fg}}",
    "editorSuggestWidget.highlightForeground": "{{find}}",
    "editorStickyScroll.background": "{{bg}}",
    "editorStickyScroll.border": "{{rule|33}}",

    // Peek view: header strip on top of a raised box
    "peekView.border": "{{accent}}",
    "peekViewTitle.background": "{{strip-bg}}",
    "peekViewTitleLabel.foreground": "{{strip-fg}}",
    "peekViewTitleDescription.foreground": "{{strip-fg|b3}}",
    "peekViewEditor.background": "{{bg-alt}}",
    "peekViewResult.background": "{{bg-raised}}",
    "peekViewResult.selectionBackground": "{{select-bg}}",
    "peekViewResult.selectionForeground": "{{select-fg}}",
    "peekViewEditor.matchHighlightBackground": "{{find|66}}",
    "peekViewResult.matchHighlightBackground": "{{find|66}}",

    // --- Tabs & editor groups -------------------------------------------------
    "editorGroupHeader.tabsBackground": "{{bg-alt}}",
    "editorGroupHeader.tabsBorder": "{{rule|33}}",
    "editorGroup.border": "{{rule|4d}}",
    "editorGroup.dropBackground": "{{select-bg|40}}",
    "tab.activeBackground": "{{bg}}",
    "tab.activeForeground": "{{fg}}",
    "tab.activeBorderTop": "{{accent}}",
    "tab.unfocusedActiveBorderTop": "{{accent|66}}",
    "tab.inactiveBackground": "{{bg-alt}}",
    "tab.inactiveForeground": "{{fg|99}}",
    "tab.hoverBackground": "{{bg-raised}}",
    "tab.border": "{{rule|33}}",
    "tab.modifiedBorder": "{{warn}}",
    "breadcrumb.foreground": "{{fg|99}}",
    "breadcrumb.focusForeground": "{{fg}}",
    "breadcrumb.activeSelectionForeground": "{{fg}}",
    "breadcrumbPicker.background": "{{bg-raised}}",

    // --- Panel (terminal, problems, output) -----------------------------------
    "panel.background": "{{bg-alt}}",
    "panel.border": "{{rule|4d}}",
    "panelTitle.activeForeground": "{{fg}}",
    "panelTitle.activeBorder": "{{accent}}",
    "panelTitle.inactiveForeground": "{{fg|99}}",
    "panelSectionHeader.background": "{{bg-raised}}",

    // --- Inputs, buttons, dropdowns -------------------------------------------
    "input.background": "{{bg}}",
    "input.foreground": "{{fg}}",
    "input.border": "{{rule|99}}",
    "input.placeholderForeground": "{{fg|66}}",
    "inputOption.activeBorder": "{{find}}",
    "inputOption.activeBackground": "{{find|33}}",
    "inputValidation.errorBackground": "{{bg-raised}}",
    "inputValidation.errorBorder": "{{error}}",
    "inputValidation.warningBackground": "{{bg-raised}}",
    "inputValidation.warningBorder": "{{warn}}",
    "dropdown.background": "{{bg-raised}}",
    "dropdown.foreground": "{{fg}}",
    "dropdown.border": "{{rule|99}}",
    "button.background": "{{button-bg}}",
    "button.foreground": "{{button-fg}}",
    "button.hoverBackground": "{{button-bg|d9}}",
    "button.border": "{{button-bg}}",
    "button.secondaryBackground": "{{bg-raised}}",
    "button.secondaryForeground": "{{fg}}",
    "button.secondaryHoverBackground": "{{bg-alt}}",
    "checkbox.background": "{{bg}}",
    "checkbox.border": "{{rule|b3}}",
    "badge.background": "{{select-bg}}",
    "badge.foreground": "{{select-fg}}",
    "progressBar.background": "{{find}}",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "{{fg|26}}",
    "scrollbarSlider.hoverBackground": "{{fg|40}}",
    "scrollbarSlider.activeBackground": "{{fg|66}}",

    // --- Notifications & quick input: "SYSTEM ERROR"-style boxes -------------
    "notifications.background": "{{bg-raised}}",
    "notifications.foreground": "{{fg}}",
    "notifications.border": "{{rule|80}}",
    "notificationCenterHeader.background": "{{strip-bg}}",
    "notificationCenterHeader.foreground": "{{strip-fg}}",
    "notificationToast.border": "{{rule|99}}",
    "notificationsErrorIcon.foreground": "{{error}}",
    "notificationsWarningIcon.foreground": "{{warn}}",
    "notificationsInfoIcon.foreground": "{{info}}",
    "quickInput.background": "{{bg-raised}}",
    "quickInput.foreground": "{{fg}}",
    "quickInputTitle.background": "{{strip-bg}}",
    "quickInputList.focusBackground": "{{select-bg}}",
    "quickInputList.focusForeground": "{{select-fg}}",
    "pickerGroup.foreground": "{{find}}",
    "pickerGroup.border": "{{rule|33}}",
    "keybindingLabel.background": "{{fg|14}}",
    "keybindingLabel.foreground": "{{fg}}",
    "keybindingLabel.border": "{{rule|4d}}",
    "keybindingLabel.bottomBorder": "{{rule|66}}",

    // --- Git & diff -----------------------------------------------------------
    "gitDecoration.addedResourceForeground": "{{success}}",
    "gitDecoration.modifiedResourceForeground": "{{warn}}",
    "gitDecoration.deletedResourceForeground": "{{error}}",
    "gitDecoration.untrackedResourceForeground": "{{success}}",
    "gitDecoration.ignoredResourceForeground": "{{fg|66}}",
    "gitDecoration.conflictingResourceForeground": "{{syn-number}}",
    "diffEditor.insertedTextBackground": "{{success|26}}",
    "diffEditor.removedTextBackground": "{{error|26}}",
    "diffEditor.insertedLineBackground": "{{success|14}}",
    "diffEditor.removedLineBackground": "{{error|14}}",

    // --- Terminal ---------------------------------------------------------------
    "terminal.background": "{{term-bg}}",
    "terminal.foreground": "{{term-fg}}",
    "terminalCursor.foreground": "{{cursor}}",
    "terminal.selectionBackground": "{{editor-select}}",
    "terminal.ansiBlack": "{{t-black}}",
    "terminal.ansiRed": "{{t-red}}",
    "terminal.ansiGreen": "{{t-green}}",
    "terminal.ansiYellow": "{{t-yellow}}",
    "terminal.ansiBlue": "{{t-blue}}",
    "terminal.ansiMagenta": "{{t-magenta}}",
    "terminal.ansiCyan": "{{t-cyan}}",
    "terminal.ansiWhite": "{{t-white}}",
    "terminal.ansiBrightBlack": "{{t-bright-black}}",
    "terminal.ansiBrightRed": "{{t-bright-red}}",
    "terminal.ansiBrightGreen": "{{t-bright-green}}",
    "terminal.ansiBrightYellow": "{{t-bright-yellow}}",
    "terminal.ansiBrightBlue": "{{t-bright-blue}}",
    "terminal.ansiBrightMagenta": "{{t-bright-magenta}}",
    "terminal.ansiBrightCyan": "{{t-bright-cyan}}",
    "terminal.ansiBrightWhite": "{{t-bright-white}}"
  },

  "tokenColors": [
    { "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{syn-comment}}", "fontStyle": "italic" } },
    { "name": "Keyword / storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "{{syn-keyword}}" } },
    { "name": "Operator",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "{{syn-param}}" } },
    { "name": "String",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "{{syn-string}}" } },
    { "name": "Escape / regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "{{syn-regex}}" } },
    { "name": "Number / constant",
      "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "{{syn-number}}" } },
    { "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "{{syn-function}}" } },
    { "name": "Type / class",
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "{{syn-type}}" } },
    { "name": "Variable",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "{{syn-variable}}" } },
    { "name": "Parameter / property",
      "scope": ["variable.parameter", "variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "{{syn-param}}" } },
    { "name": "Parameter (italic)",
      "scope": ["variable.parameter"],
      "settings": { "fontStyle": "italic" } },
    { "name": "Language variable",
      "scope": ["variable.language", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "{{syn-keyword}}", "fontStyle": "italic" } },
    { "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "{{syn-tag}}" } },
    { "name": "Attribute / decorator",
      "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "{{syn-attr}}" } },
    { "name": "CSS property / JSON key",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "{{syn-attr}}" } },
    { "name": "Namespace / module",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"],
      "settings": { "foreground": "{{syn-type}}" } },
    { "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{error}}", "fontStyle": "underline" } },

    { "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section", "markup.heading punctuation.definition.heading"],
      "settings": { "foreground": "{{syn-heading}}", "fontStyle": "bold" } },
    { "name": "Markdown bold",   "scope": ["markup.bold"],   "settings": { "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "{{syn-function}}" } },
    { "name": "Markdown quote / list",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "{{syn-comment}}" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "{{success}}" } },
    { "name": "Diff deleted",  "scope": ["markup.deleted"],  "settings": { "foreground": "{{error}}" } },
    { "name": "Diff changed",  "scope": ["markup.changed"],  "settings": { "foreground": "{{warn}}" } }
  ],

  "semanticTokenColors": {
    "namespace": "{{syn-type}}",
    "type": "{{syn-type}}",
    "class": "{{syn-type}}",
    "enum": "{{syn-type}}",
    "interface": "{{syn-type}}",
    "typeParameter": "{{syn-type}}",
    "function": "{{syn-function}}",
    "method": "{{syn-function}}",
    "macro": "{{syn-function}}",
    "parameter": { "foreground": "{{syn-param}}", "italic": true },
    "property": "{{syn-param}}",
    "enumMember": "{{syn-number}}",
    "variable.readonly": "{{syn-number}}",
    "decorator": "{{syn-attr}}",
    "keyword": "{{syn-keyword}}",
    "comment": { "foreground": "{{syn-comment}}", "italic": true },
    "string": "{{syn-string}}",
    "number": "{{syn-number}}",
    "regexp": "{{syn-regex}}"
  }
}
