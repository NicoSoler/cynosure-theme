#!/usr/bin/env bash
# Screenshot to ~/Pictures/Screenshots and the clipboard.
#   cynosure-screenshot screen|area
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/cynosure-$(date +%Y%m%d-%H%M%S).png"

case "${1:-screen}" in
  screen) grim "$file" ;;
  area)   region="$(slurp -d -b '{{void|bare}}aa' -c '{{cream|bare}}ff' -s '{{cream|bare}}22' -w 2)" || exit 0
          grim -g "$region" "$file" ;;
  *)      echo "usage: $0 screen|area" >&2; exit 1 ;;
esac

wl-copy --type image/png < "$file"
notify-send -a "CYNOSURE SYSTEMS" -i "$file" -t 3000 "CAPTURE STORED" "$(basename "$file")" 2>/dev/null || true
