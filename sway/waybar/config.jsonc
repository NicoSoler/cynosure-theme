// Cynosure — Waybar. GENERATED from sway/waybar/config.jsonc by build.py.
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["custom/cynosure", "sway/workspaces", "sway/mode", "sway/scratchpad"],
  "modules-center": ["sway/window"],
  "modules-right":  ["pulseaudio", "network", "cpu", "memory", "clock", "tray"],

  // The "CODE MATRIX"-style header block. Click opens the launcher.
  "custom/cynosure": {
    "format": "CYNOSURE",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}"
  },

  "sway/mode": {
    "format": "MODE: {}"
  },

  "sway/scratchpad": {
    "format": "BUFFER {count}",
    "show-empty": false,
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  "sway/window": {
    "format": "{title}",
    "max-length": 70,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL MUTED",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-ethernet": "LYNX_ETH {ipaddr}",
    "format-wifi": "WIFI {essid} {signalStrength}%",
    "format-linked": "LINK {ifname}",
    "format-disconnected": "SIGNAL LOST",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}  via {gwaddr}",
    "on-click": "nm-connection-editor"
  },

  "cpu": {
    "format": "CPU {usage:>2}%",
    "interval": 3,
    "states": { "warning": 70, "critical": 90 }
  },

  "memory": {
    "format": "MEM {percentage:>2}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "states": { "warning": 75, "critical": 90 }
  },

  "clock": {
    "format": "TIME {:%H:%M}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span background='{{cream}}' color='{{void}}'><b>{}</b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
